                  "description": "City and region."
                },
                "services": {
                  "type": "string",
                  "description": "What the site offers, e.g. \"Sales · Service · Parts\"."
                },
                "url": {
                  "type": "string",
                  "description": "Location page."
                }
              },
              "required": [
                "city"
              ]
            }
          },
          "testimonial": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string",
                "description": "Quote."
              },
              "name": {
                "type": "string",
                "description": "Name."
              },
              "role": {
                "type": "string",
                "description": "Role."
              }
            }
          }
        }
      }
