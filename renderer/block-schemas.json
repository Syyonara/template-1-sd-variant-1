                "name": {
                  "type": "string",
                  "description": "Brand name."
                },
                "image": {
                  "type": "object",
                  "description": "An uploaded image, referenced by public URL. Never a base64 data URI.",
                  "properties": {
                    "src": {
                      "type": "string",
                      "description": "Public image URL from the media library."
                    },
                    "alt": {
                      "type": "string",
                      "description": "Descriptive alternative text. Required for anything not decorative."
                    },
                    "width": {
                      "type": "integer",
                      "description": "Intrinsic width in pixels."
                    },
                    "height": {
                      "type": "integer",
                      "description": "Intrinsic height in pixels."
                    }
                  },
                  "required": [
                    "src",
                    "alt"
                  ]
                },
                "url": {
                  "type": "string",
                  "description": "Brand page."
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "logos"
        ]
      }
