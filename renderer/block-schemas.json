                "quote": {
                  "type": "string",
                  "description": "The customer's words. Never fabricate a review."
                },
                "name": {
                  "type": "string",
                  "description": "Who said it."
                },
                "role": {
                  "type": "string",
                  "description": "Their context, e.g. \"Owner-operator\"."
                },
                "rating": {
                  "type": "integer",
                  "description": "Stars out of five.",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "required": [
                "quote",
                "name"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    },
    {
      "id": "logoStrip",
      "label": "Logo strip",
      "category": "section",
      "autoTagged": true,
      "schema": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "description": "Optional label, e.g. \"Brands we carry\"."
          },
          "headingLevel": {
            "type": "integer",
            "description": "Heading level for this block. Keep one h1 per page.",
            "minimum": 1,
            "maximum": 6,
            "default": 2
          },
          "logos": {
            "type": "array",
