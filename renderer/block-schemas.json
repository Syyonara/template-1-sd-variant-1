      "autoTagged": true,
      "schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Body copy. Plain paragraphs separated by a blank line; inline <strong>, <em> and <a> are allowed."
          },
          "align": {
            "type": "string",
            "description": "Text alignment.",
            "enum": [
              "left",
              "center"
            ],
            "default": "left"
          },
          "width": {
            "type": "string",
            "description": "Measure.",
            "enum": [
              "prose",
              "full"
            ],
            "default": "prose"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "id": "image",
      "label": "Image",
      "category": "content",
      "autoTagged": true,
      "schema": {
        "type": "object",
        "properties": {
          "image": {
            "type": "object",
            "description": "An uploaded image, referenced by public URL. Never a base64 data URI.",
            "properties": {
              "src": {
                "type": "string",
                "description": "Public image URL from the media library."
              },
              "alt": {
                "type": "string",
                "description": "Descriptive alternative text. Required for anything not decorative."
              },
              "width": {
                "type": "integer",
                "description": "Intrinsic width in pixels."
              },
              "height": {
                "type": "integer",
                "description": "Intrinsic height in pixels."
              }
            },
            "required": [
              "src",
              "alt"
            ]
          },
          "caption": {
            "type": "string",
            "description": "Optional caption shown under the image."
          },
          "width": {
            "type": "string",
            "description": "How wide the image sits.",
            "enum": [
              "prose",
              "full"
            ],
            "default": "full"
          }
        },
        "required": [
          "image"
        ]
      }
    },
    {
      "id": "buttons",
      "label": "Buttons",
      "category": "content",
      "autoTagged": true,
      "schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "description": "Calls to action, in order.",
            "items": {
              "type": "object",
              "description": "A call to action. Prefer `ctaId` referencing the dealer's Buttons library over an inline label/url — a library CTA keeps its label, destination and tagging consistent everywhere it appears.",
              "properties": {
                "ctaId": {
                  "type": "string",
                  "description": "Id of an entry in site/buttons.json."
                },
                "label": {
                  "type": "string",
                  "description": "Inline label. Overrides the library label when both are set."
                },
                "url": {
                  "type": "string",
                  "description": "Inline destination. Overrides the library destination."
                },
                "style": {
                  "type": "string",
                  "description": "Visual variant.",
                  "enum": [
                    "primary",
                    "secondary",
                    "link"
                  ]
                },
                "intent": {
                  "type": "string",
                  "description": "Analytics intent, e.g. \"get-quote\". Defaults to the library value."
                }
              }
            },
            "maxItems": 3
          },
          "align": {
            "type": "string",
            "description": "Text alignment.",
            "enum": [
              "left",
              "center"
            ],
            "default": "left"
          }
        },
        "required": [
          "items"
        ]
      }
    },
