            "type": "integer",
            "description": "Heading level for this block. Keep one h1 per page.",
            "minimum": 1,
            "maximum": 6,
            "default": 2
          },
          "align": {
            "type": "string",
            "description": "Text alignment.",
            "enum": [
              "left",
              "center"
            ],
            "default": "left"
          }
        },
        "required": [
