            "type": "boolean",
            "description": "Pull locations from the dealer's Locations module instead of the list below. Prefer this — a hand-typed list goes stale the day a location is added."
          },
          "locations": {
            "type": "array",
            "description": "Only used when useLiveLocations is false.",
            "items": {
