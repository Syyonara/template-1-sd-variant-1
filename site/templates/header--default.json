{
  "version": 1,
  "name": "Header",
  "slot": "header",
  "blocks": [
    {
      "id": "header-bar",
      "type": "bar",
      "props": {
        "background": "card",
        "sticky": true,
        "divider": true,
        "columns": [
          [{ "id": "header-logo", "type": "logo", "props": { "url": "/", "height": 34 } }],
          [
            {
              "id": "header-nav",
              "type": "menu",
              "props": { "location": "primary", "layout": "horizontal", "align": "center", "collapseOnMobile": true }
            }
          ],
          [
            {
              "id": "header-cta",
              "type": "buttons",
              "props": { "items": [{ "ctaId": "browse-inventory" }], "align": "left" }
            }
          ]
        ]
      }
    }
  ]
}
