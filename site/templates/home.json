{
  "version": 2,
  "id": "home",
  "name": "Home template (nav over the hero)",
  "conditions": [
    {
      "type": "page",
      "ref": "home"
    }
  ],
  "nodes": [
    {
      "id": "chrome",
      "type": "section",
      "props": {
        "width": "full",
        "paddingY": 0,
        "background": "none",
        "anchor": "top"
      },
      "styles": {
        "base": {
          "position": "absolute",
          "top": 0,
          "left": 0,
          "right": 0,
          "zIndex": 40
        }
      },
      "children": [
        {
          "id": "utility-row",
          "type": "row",
          "props": {
            "gap": 3,
            "align": "center",
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "background": "ink",
              "paddingTop": 10,
              "paddingBottom": 10,
              "paddingLeft": 24,
              "paddingRight": 24,
              "flexWrap": "wrap"
            },
            "mobile": {
              "paddingLeft": 20,
              "paddingRight": 20
            }
          },
          "children": [
            {
              "id": "utility-left",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "utility-phone",
                  "type": "menu",
                  "props": {
                    "menuId": "utility-phone",
                    "layout": "horizontal",
                    "align": "start",
                    "depth": 1
                  },
                  "styles": {
                    "base": {
                      "textColor": "#f2eee6",
                      "fontWeight": "700",
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                }
              ]
            },
            {
              "id": "utility-right",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "utility-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "utility",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  },
                  "styles": {
                    "base": {
                      "textColor": "#d8d2c4",
                      "fontSize": 14,
                      "fontWeight": "500",
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                }
              ],
              "styles": {
                "mobile": {
                  "hide": true
                }
              }
            }
          ]
        },
        {
          "id": "masthead-row",
          "type": "row",
          "props": {
            "gap": 4,
            "align": "center",
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "maxWidth": 1440,
              "marginLeft": "auto",
              "marginRight": "auto",
              "paddingTop": 18,
              "paddingBottom": 18,
              "paddingLeft": 24,
              "paddingRight": 24,
              "width": "100%"
            },
            "mobile": {
              "paddingLeft": 20,
              "paddingRight": 20
            }
          },
          "children": [
            {
              "id": "masthead-brand",
              "type": "column",
              "props": {
                "span": 5,
                "align": "center"
              },
              "children": [
                {
                  "id": "logo",
                  "type": "logo",
                  "props": {
                    "url": "/",
                    "height": 26,
                    "text": "Ironhaul Truck Centers"
                  },
                  "styles": {
                    "base": {
                      "textColor": "#ffffff",
                      "textTransform": "uppercase",
                      "letterSpacing": "0.02em",
                      "whiteSpace": "nowrap",
                      "paddingTop": 0,
                      "paddingBottom": 0
                    },
                    "mobile": {
                      "whiteSpace": "normal"
                    }
                  }
                }
              ],
              "styles": {
                "base": {
                  "display": "flex",
                  "flexDirection": "row",
                  "alignItems": "center",
                  "gap": 2
                }
              }
            },
            {
              "id": "masthead-nav",
              "type": "column",
              "props": {
                "span": 7,
                "align": "center"
              },
              "children": [
                {
                  "id": "main-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "main",
                    "layout": "horizontal",
                    "align": "end",
                    "collapseOnMobile": true,
                    "depth": 2
                  },
                  "styles": {
                    "base": {
                      "textColor": "#ffffff",
                      "textTransform": "uppercase",
                      "fontWeight": "700",
                      "fontSize": 13,
                      "letterSpacing": "0.01em",
                      "paddingTop": 4,
                      "paddingBottom": 4,
                      "background": "#1a1714@70%",
                      "radius": 10,
                      "paddingLeft": 8,
                      "paddingRight": 8
                    },
                    "tablet": {
                      "textColor": "ink",
                      "background": "#00000000",
                      "paddingLeft": 0,
                      "paddingRight": 0
                    }
                  }
                },
                {
                  "id": "nav-search",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "Search inventory",
                        "url": "/store",
                        "style": "link",
                        "intent": "inventory-search"
                      }
                    ]
                  },
                  "styles": {
                    "base": {
                      "marginLeft": 4,
                      "paddingTop": 0,
                      "paddingBottom": 0
                    },
                    "tablet": {
                      "hide": true
                    }
                  }
                }
              ],
              "styles": {
                "base": {
                  "display": "flex",
                  "flexDirection": "row",
                  "alignItems": "center",
                  "justifyContent": "flex-end",
                  "gap": 1
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "content",
      "type": "contentArea",
      "props": {
        "label": "Page content"
      }
    },
    {
      "id": "site-footer",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 8,
        "background": "ink"
      },
      "children": [
        {
          "id": "footer-cols",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "start",
            "stackOn": "tablet"
          },
          "styles": {
            "base": {
              "paddingBottom": 36,
              "borderWidth": 0,
              "borderBottomWidth": 1,
              "borderColor": "#38332c"
            }
          },
          "children": [
            {
              "id": "footer-brand",
              "type": "column",
              "props": {
                "span": 3
              },
              "children": [
                {
                  "id": "footer-logo",
                  "type": "logo",
                  "props": {
                    "url": "/",
                    "height": 24,
                    "text": "Ironhaul Truck Centers"
                  },
                  "styles": {
                    "base": {
                      "textColor": "#ffffff",
                      "textTransform": "uppercase",
                      "marginBottom": 14
                    }
                  }
                },
                {
                  "id": "footer-blurb",
                  "type": "text",
                  "props": {
                    "text": "Serving fleets and owner-operators with new and used trucks, service, and parts.",
                    "width": "prose"
                  },
                  "styles": {
                    "base": {
                      "textColor": "#9c9484",
                      "fontSize": 13,
                      "lineHeight": 1.6
                    }
                  }
                }
              ]
            },
            {
              "id": "footer-shop",
              "type": "column",
              "props": {
                "span": 3
              },
              "children": [
                {
                  "id": "footer-shop-h",
                  "type": "heading",
                  "props": {
                    "text": "Shop",
                    "headingLevel": 4
                  },
                  "styles": {
                    "base": {
                      "textColor": "#ffffff",
                      "fontSize": 13,
                      "textTransform": "uppercase",
                      "letterSpacing": "0.08em",
                      "marginBottom": 14
                    }
                  }
                },
                {
                  "id": "footer-shop-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "footer",
                    "layout": "vertical",
                    "depth": 1
                  },
                  "styles": {
                    "base": {
                      "textColor": "#b8b0a2",
                      "fontSize": 13
                    }
                  }
                }
              ]
            },
            {
              "id": "footer-support",
              "type": "column",
              "props": {
                "span": 3
              },
              "children": [
                {
                  "id": "footer-support-h",
                  "type": "heading",
                  "props": {
                    "text": "Support",
                    "headingLevel": 4
                  },
                  "styles": {
                    "base": {
                      "textColor": "#ffffff",
                      "fontSize": 13,
                      "textTransform": "uppercase",
                      "letterSpacing": "0.08em",
                      "marginBottom": 14
                    }
                  }
                },
                {
                  "id": "footer-support-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "footer-support",
                    "layout": "vertical",
                    "depth": 1
                  },
                  "styles": {
                    "base": {
                      "textColor": "#b8b0a2",
                      "fontSize": 13
                    }
                  }
                }
              ]
            },
            {
              "id": "footer-company",
              "type": "column",
              "props": {
                "span": 3
              },
              "children": [
                {
                  "id": "footer-company-h",
                  "type": "heading",
                  "props": {
                    "text": "Company",
                    "headingLevel": 4
                  },
                  "styles": {
                    "base": {
                      "textColor": "#ffffff",
                      "fontSize": 13,
                      "textTransform": "uppercase",
                      "letterSpacing": "0.08em",
                      "marginBottom": 14
                    }
                  }
                },
                {
                  "id": "footer-company-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "footer-company",
                    "layout": "vertical",
                    "depth": 1
                  },
                  "styles": {
                    "base": {
                      "textColor": "#b8b0a2",
                      "fontSize": 13
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "footer-legal-row",
          "type": "row",
          "props": {
            "gap": 3,
            "align": "center",
            "stackOn": "mobile"
          },
          "styles": {
            "base": {
              "paddingTop": 20
            }
          },
          "children": [
            {
              "id": "footer-copyright",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "footer-copy",
                  "type": "text",
                  "props": {
                    "text": "© Ironhaul Truck Centers. All rights reserved.",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
                      "textColor": "#8a8273",
                      "fontSize": 12
                    }
                  }
                }
              ]
            },
            {
              "id": "footer-legal-links",
              "type": "column",
              "props": {
                "span": 4,
                "align": "center"
              },
              "children": [
                {
                  "id": "footer-legal-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "legal",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  },
                  "styles": {
                    "base": {
                      "textColor": "#8a8273",
                      "fontSize": 12
                    }
                  }
                }
              ]
            },
            {
              "id": "footer-builtby",
              "type": "column",
              "props": {
                "span": 2,
                "align": "center"
              },
              "children": [
                {
                  "id": "footer-builtby-mark",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/images/buzznerd-logo-white.png",
                      "alt": "Built by BuzzNerd",
                      "width": 96,
                      "height": 16
                    },
                    "width": "full",
                    "url": "https://buzznerd.com"
                  },
                  "styles": {
                    "base": {
                      "maxWidth": 96,
                      "marginLeft": "auto",
                      "opacity": 70
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "totop-holder",
      "type": "section",
      "props": {
        "width": "full",
        "paddingY": 0,
        "background": "none",
        "behaviour": "scrollstate",
        "behaviourOptions": "{\"after\":600}"
      },
      "children": [
        {
          "id": "totop-row",
          "type": "row",
          "props": {
            "gap": 0
          },
          "children": [
            {
              "id": "totop-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "totop",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "back-to-top"
                      }
                    ],
                    "align": "left",
                    "part": "totop"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
