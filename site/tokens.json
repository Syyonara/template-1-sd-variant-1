  "colors": {
    "accent": "#e8531f",
    "accentDark": "#a23a16",
    "ink": "#1a1714",
    "inkDark": "#0f0d0b",
    "muted": "#6b6354",
    "line": "#e1dacb",
    "card": "#ffffff",
    "paper": "#faf8f4"
  },
  "status": {
    "ok": "#157347",
    "info": "#3b5fa0",
    "warn": "#b45309",
    "bad": "#c62828"
