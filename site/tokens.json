  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48
  },
  "radius": {
    "nav": 7,
    "input": 10,
    "card": 14,
    "modal": 16,
    "chip": 999
  },
  "layout": {
    "container": "1440px",
    "padDesktop": 24,
    "padTablet": 24,
    "padMobile": 20
  }
