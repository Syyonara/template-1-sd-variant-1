        "style": "normal",
        "display": "swap"
      },
      {
        "family": "INTL Text",
        "url": "/fonts/INTLText-Light.woff2",
        "weight": 300,
        "style": "normal",
        "display": "swap"
      },
      {
        "family": "INTL Text",
        "url": "/fonts/INTLText-LightItalic.woff2",
        "weight": 300,
        "style": "italic",
        "display": "swap"
      },
      {
        "family": "INTL Text",
        "url": "/fonts/INTLText-Regular.woff2",
