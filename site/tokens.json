      {
        "family": "INTL Text",
        "url": "/fonts/INTLText-Medium.woff2",
        "weight": 500,
        "style": "normal",
        "display": "swap"
      },
      {
        "family": "INTL Text",
        "url": "/fonts/INTLText-MediumItalic.woff2",
        "weight": 500,
        "style": "italic",
        "display": "swap"
      },
      {
        "family": "INTL Text",
        "url": "/fonts/INTLText-Bold.woff2",
        "weight": "600 900",
        "style": "normal",
        "display": "swap"
      },
      {
        "family": "INTL Text",
        "url": "/fonts/INTLText-BoldItalic.woff2",
        "weight": "600 900",
        "style": "italic",
        "display": "swap"
      }
    ]
