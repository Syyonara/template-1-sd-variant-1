{
  "$schema": "./tokens.schema.json",
  "version": 2,
  "fonts": {
    "heading": "INTL Headline",
    "body": "INTL Text",
    "files": [
      {
        "family": "INTL Headline",
        "url": "/fonts/INTLHeadline-Light.woff2",
        "weight": 300,
        "style": "normal",
        "display": "swap"
      },
      {
        "family": "INTL Headline",
        "url": "/fonts/INTLHeadline-Regular.woff2",
