{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/inventory", "destination": "https://storefront.buzznerd.com/REPLACE_CHANNEL_TOKEN/inventory" },
    { "source": "/inventory/:path*", "destination": "https://storefront.buzznerd.com/REPLACE_CHANNEL_TOKEN/inventory/:path*" }
  ],
  "headers": [
    { "source": "/partials/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" } ] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
